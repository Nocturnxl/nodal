{
  "name": "nodal",
  "productName": "NODAL",
  "version": "0.1.0",
  "description": "Provider-agnostic desktop interface for AI models: your models, your endpoints, your control.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Nocturnxl",
  "license": "MIT",
  "homepage": "https://github.com/Nocturnxl/nodal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nocturnxl/nodal.git"
  },
  "bugs": {
    "url": "https://github.com/Nocturnxl/nodal/issues"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "brand": "node scripts/make-brand-assets.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "screenshots": "npm run bundle && node scripts/screenshots.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "perf:db": "vitest run --config vitest.perf.config.mts",
    "perf:ui": "npm run bundle && playwright test -c playwright.perf.config.ts",
    "smoke:venice": "vitest run --config vitest.live.config.mts",
    "bundle": "electron-vite build",
    "build": "npm run typecheck && npm run bundle && npm run test",
    "e2e": "npm run bundle && playwright test",
    "start": "electron-vite preview",
    "mock": "node tests/mock/run.mts",
    "rebuild": "electron-builder install-app-deps",
    "dist": "npm run build && npm run notices && electron-builder",
    "dist:dir": "npm run bundle && npm run notices && electron-builder --dir"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "13.2.0",
    "electron-updater": "6.8.11",
    "fflate": "0.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-virtual": "3.14.26",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "highlight.js": "^11.11.1",
    "katex": "0.19.1",
    "lucide-react": "1.73.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "~5.9.0",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "zustand": "5.1.0"
  },
  "overrides": {
    "katex": "$katex"
  }
}
